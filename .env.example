# Copy to .env and fill in. .env is gitignored — never commit it.
# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords  (16 chars, spaces optional)
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Comma-separated recipients (defaults to GMAIL_ADDRESS)
DIGEST_TO=you@gmail.com
# Optional: official X API bearer token (pay-per-use). Leave empty to skip X.
# https://developer.x.com → your app → Keys and tokens → Bearer Token
X_BEARER_TOKEN=
